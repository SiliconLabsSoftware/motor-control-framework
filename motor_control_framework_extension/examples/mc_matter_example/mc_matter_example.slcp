project_name: mc_matter_example
package: Motor Control Framework Extension
label: >
  Motor Control Framework - Matter Example
description: >
  Demonstrates the Motor Control Framework running on a radio board with control implemented on Matter over Thread.
category: Motor Control Framework Examples
quality: experimental

filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

sdk_extension:
  - id: motor_control_framework_extension
    vendor: silabs
    version: 1.0.0
  - id: matter
    vendor: silabs
    version: 2.8.0

sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2025.12.0

toolchain_settings:
- value: gnu++17
  option: cxx_standard

component:
- package: motor_control_framework_extension
  vendor: silabs
  id: motor_control_framework
- package: simplicity_sdk
  vendor: silabs
  id: cpp_support
- package: simplicity_sdk
  vendor: silabs
  id: sl_main
- package: matter
  vendor: silabs
  id: app_common
- package: matter
  vendor: silabs
  id: matter
- package: matter
  vendor: silabs
  id: matter_access_control
- package: matter
  vendor: silabs
  id: matter_administrator_commissioning
- package: matter
  vendor: silabs
  id: matter_basic_information
- package: matter
  vendor: silabs
  id: matter_ble
- package: matter
  vendor: silabs
  id: matter_configuration_over_swo
- package: matter
  vendor: silabs
  id: matter_crypto
- package: matter
  vendor: silabs
  id: matter_descriptor
- package: matter
  vendor: silabs
  id: matter_fan_control
- package: matter
  vendor: silabs
  id: matter_fan_control_app
- package: matter
  vendor: silabs
  id: matter_fixed_label
- package: matter
  vendor: silabs
  id: matter_gatt_static
- package: matter
  vendor: silabs
  id: matter_general_commissioning
- package: matter
  vendor: silabs
  id: matter_general_diagnostics
- package: matter
  vendor: silabs
  id: matter_group_key_mgmt
- package: matter
  vendor: silabs
  id: matter_groups
- package: matter
  vendor: silabs
  id: matter_identify
- package: matter
  vendor: silabs
  id: matter_leds
- package: matter
  vendor: silabs
  id: matter_localization_configuration
- package: matter
  vendor: silabs
  id: matter_network_commissioning
- package: matter
  vendor: silabs
  id: matter_no_lcd_shell
- package: matter
  vendor: silabs
  id: matter_operational_credentials
- package: matter
  vendor: silabs
  id: matter_ota_requestor
- package: matter
  vendor: silabs
  id: matter_ota_support
- package: matter
  vendor: silabs
  id: matter_platform_mg
- package: matter
  vendor: silabs
  id: matter_power_source
- package: matter
  vendor: silabs
  id: matter_provision_default
- package: matter
  vendor: silabs
  id: matter_segger_rtt
- package: matter
  vendor: silabs
  id: matter_software_diagnostics
- package: matter
  vendor: silabs
  id: matter_thread
- package: matter
  vendor: silabs
  id: matter_thread_network_diagnostics
- package: matter
  vendor: silabs
  id: matter_time_format_localization
- package: matter
  vendor: silabs
  id: matter_user_label
- package: simplicity_sdk
  vendor: silabs
  id: EFR32MG26B510F3200IL136
- package: simplicity_sdk
  vendor: silabs
  id: brd4118a
- package: simplicity_sdk
  vendor: silabs
  id: clock_manager
- package: simplicity_sdk
  vendor: silabs
  id: device_init
- package: simplicity_sdk
  vendor: silabs
  id: hal_iadc
- package: simplicity_sdk
  vendor: silabs
  id: hal_timer
- package: simplicity_sdk
  vendor: silabs
  id: power_manager_no_deepsleep
- package: simplicity_sdk
  vendor: silabs
  id: rail_util_pti
- package: simplicity_sdk
  vendor: silabs
  id: segger_systemview
- package: simplicity_sdk
  instance:
  - btn0
  vendor: silabs
  id: simple_button
- package: simplicity_sdk
  instance:
  - led0
  vendor: silabs
  id: simple_led


source:
  - path: src/AppTask.cpp
  - path: src/DataModelCallbacks.cpp
  - path: src/FanControlManager.cpp
  - path: src/main.cpp
  - path: src/motor_control.cpp
include:
  - path: include
    file_list:
    - path: AppConfig.h
    - path: AppEvent.h
    - path: AppTask.h
    - path: CHIPProjectConfig.h
    - path: FanControlManager.h
    - path: motor_control.h

requires:
- name: matter_drivers_series_2

define:
  - name: CHIP_CRYPTO_PLATFORM
    value: "1"
  - name: _WANT_REENT_SMALL
    value: "1"
  - name: NVM3_DEFAULT_NVM_SIZE
    value: "40960"
  - name: NVM3_DEFAULT_MAX_OBJECT_SIZE
    value: "4092"

configuration:
- condition:
  - matter_ble_side_channel
  name: SL_BT_CONFIG_USER_ADVERTISERS
  value: '2'
- name: SL_OPENTHREAD_ENABLE_APP_TASK
  value: '0'
- name: SL_OPENTHREAD_ENABLE_CLI_TASK
  value: '0'
- name: OPENTHREAD_CONFIG_LOG_OUTPUT
  value: OPENTHREAD_CONFIG_LOG_OUTPUT_APP
- condition:
  - matter_thread_cert_libs
  name: SL_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
  value: '1'
- name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
  value: '1'
- condition:
  - matter_thread_coap_cert_libs
  name: OPENTHREAD_CONFIG_COAP_API_ENABLE
  value: '1'
- condition:
  - matter_thread_coap_cert_libs
  name: OPENTHREAD_CONFIG_COAP_OBSERVE_API_ENABLE
  value: '1'
- condition:
  - matter_thread_coap_cert_libs
  name: OPENTHREAD_CONFIG_COAP_SECURE_API_ENABLE
  value: '1'
- name: SL_STACK_SIZE
  value: '4608'
- name: SL_BT_RTOS_EVENT_HANDLER_STACK_SIZE
  value: '1536'
- name: CIRCULAR_QUEUE_LEN_MAX
  value: '16'
- name: SL_MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS
  value: '1'
- name: SL_CLOCK_MANAGER_HFRCO_DPLL_EN
  value: "1"
- name: SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE
  value: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFRCODPLL"

config_file:
  - path: config/fan-control-thread-app.zap
    directory: common
  - path: config/provision.mattpconf
    directory: provision
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: gatt_configuration.btconf
    directory: btconf
  # Board-specific overlays for motor_control_framework_config.h.
  # Each entry is gated by a board feature and overrides the framework's
  # default config file when that board is selected. If none match, the
  # generic motor_control_framework_config.h ships unchanged.
  - override:
      component: motor_control_framework
      file_id: motor_control_framework_config
    path: ../../motor_control_framework/overlays/brd4118a/motor_control_framework_config.h
    condition:
      - brd4118a

readme:
  - path: README.md

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
    - path: readme.md
      focus: true
