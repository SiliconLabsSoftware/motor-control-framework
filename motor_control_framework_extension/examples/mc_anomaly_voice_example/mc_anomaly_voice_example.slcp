project_name: mc_anomaly_voice_example
package: Motor Control Framework Extension
label: >
  Motor Control Framework - Anomaly & Voice Example
description: >
  Demonstrates the Motor Control Framework running Hall-sensor velocity control
  with an on-device AI/ML safety layer: an IMU vibration-anomaly autoencoder and
  an audio keyword-spotting model, switchable at runtime. A high anomaly score
  triggers a motor fail-safe stop.
category: Motor Control Framework Examples
quality: experimental

filter:
  - name: "Motor Control"
    value: ["Hall Sensor"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "Capability"
    value: ["Machine Learning"]

sdk_extension:
  - id: motor_control_framework_extension
    vendor: silabs
    version: 1.0.0
  - id: aiml
    vendor: silabs
    version: 2.2.0

sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2025.12.0

toolchain_settings:
  - option: gcc_compiler_option
    value: -Wno-unused-parameter
  - option: gcc_compiler_option
    value: -Wno-missing-field-initializers
  - option: gcc_linker_option
    value: -u _printf_float

component:
# --- Motor Control Framework ---
- package: motor_control_framework_extension
  vendor: silabs
  id: motor_control_framework
# --- Platform / kernel ---
- package: simplicity_sdk
  vendor: silabs
  id: clock_manager
- package: simplicity_sdk
  vendor: silabs
  id: cpp_support
- package: simplicity_sdk
  vendor: silabs
  id: device_init
- package: simplicity_sdk
  vendor: silabs
  id: sl_main
- package: simplicity_sdk
  vendor: silabs
  id: freertos_heap_3
- package: simplicity_sdk
  vendor: silabs
  id: cycle_counter
- package: simplicity_sdk
  vendor: silabs
  id: gpiointerrupt
- package: simplicity_sdk
  vendor: silabs
  id: iostream_rtt
- package: simplicity_sdk
  vendor: silabs
  id: segger_systemview
# --- AI/ML (aiml extension) ---
- package: aiml
  vendor: silabs
  id: ml_audio_feature_generation
- package: aiml
  vendor: silabs
  id: tensorflow_lite_micro
- package: aiml
  vendor: silabs
  id: tensorflow_lite_micro_accelerated_kernels
- package: aiml
  vendor: silabs
  id: tensorflow_lite_micro_optimized_kernels
# --- Sensors / peripherals for the AI demo ---
- package: simplicity_sdk
  vendor: silabs
  id: mic_i2s_driver
- package: simplicity_sdk
  instance:
  - exp
  vendor: silabs
  id: spidrv_eusart
- package: simplicity_sdk
  instance:
  - btn0
  vendor: silabs
  id: simple_button
# --- BLE features used by telemetry / device info ---
- package: simplicity_sdk
  vendor: silabs
  id: bluetooth_stack
- package: simplicity_sdk
  vendor: silabs
  id: bluetooth_feature_system
- package: simplicity_sdk
  vendor: silabs
  id: bluetooth_feature_extended_advertiser
- package: simplicity_sdk
  vendor: silabs
  id: gatt_service_device_information_override

source:
  - path: app.cpp
  - path: ble_handler.cpp
  - path: motor_control.cpp
  - path: blinky.cpp
  - path: telemetry.cpp
  - path: imu_task.cpp
  - path: audio_classifier.cc
  - path: recognize_commands.cc
  - path: imu/sl_lsm6dsm.c
  - path: imu/lsm6dsm_reg.c
  - path: model/sl_tflite_micro_model_audio.c

include:
  - path: .
    file_list:
      - path: app.h
      - path: ble_handler.h
      - path: motor_control.h
      - path: blinky.h
      - path: telemetry.h
      - path: imu_task.h
      - path: audio_classifier.h
      - path: recognize_commands.h
      - path: ml_common.h
      - path: constants.h
  - path: imu
    file_list:
      - path: sl_lsm6dsm.h
      - path: lsm6dsm_reg.h
  - path: model
    file_list:
      - path: sl_tflite_micro_model_audio.h
      - path: sl_tflite_micro_model_parameters.h

define:
  - name: DEBUG_EFM
  - name: TF_LITE_STATIC_MEMORY

config_file:
  # BLE GATT database
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: gatt_configuration.btconf
    directory: btconf
  # Audio keyword-spotting tuning (category labels, thresholds)
  - path: config/audio_classifier_config.h
  # Microphone I2S pin map (USART0). BRD4120A ships no mic config, so the
  # example provides the full pin-tool header (peripheral + pins).
  - override:
      component: mic_i2s_driver
      file_id: mic_i2s_config
    path: config/sl_mic_i2s_config.h
  # IMU anomaly autoencoder model (drives sl_tflite_model_array via flatbuffer)
  - path: tflite/autoencoder_quantized.tflite
    directory: tflite
  # Board overlay for the framework pin map / motor parameters
  - override:
      component: motor_control_framework
      file_id: motor_control_framework_config
    path: ../../motor_control_framework/overlays/brd4120a/motor_control_framework_config.h
    condition:
      - brd4120a

configuration:
  # The microphone pin map comes from the config_file override above. The
  # BRD4120A board package already provides the SPI (exp) and button configs,
  # so we layer the demo's specific wiring on top here instead of overriding:
  # the LSM6DSM IMU shares the DRV8305 EUSART1 SPI bus (PC2/PC6/PC3) with an
  # application-controlled CS on PA6, and the model-switch button is on PC0.
  - name: SL_SPIDRV_EUSART_EXP_CS_CONTROL
    value: spidrvCsControlApplication
  - name: SL_SPIDRV_EUSART_EXP_TX_PORT
    value: SL_GPIO_PORT_C
  - name: SL_SPIDRV_EUSART_EXP_TX_PIN
    value: "2"
  - name: SL_SPIDRV_EUSART_EXP_RX_PORT
    value: SL_GPIO_PORT_C
  - name: SL_SPIDRV_EUSART_EXP_RX_PIN
    value: "6"
  - name: SL_SPIDRV_EUSART_EXP_SCLK_PORT
    value: SL_GPIO_PORT_C
  - name: SL_SPIDRV_EUSART_EXP_SCLK_PIN
    value: "3"
  - name: SL_SPIDRV_EUSART_EXP_CS_PORT
    value: SL_GPIO_PORT_A
  - name: SL_SPIDRV_EUSART_EXP_CS_PIN
    value: "6"
  - name: SL_SIMPLE_BUTTON_BTN0_PORT
    value: SL_GPIO_PORT_C
  - name: SL_SIMPLE_BUTTON_BTN0_PIN
    value: "0"
  # Memory / TFLite arena
  - name: SL_HEAP_SIZE
    value: "12288"
  - name: SL_TFLITE_MICRO_INTERPRETER_INIT_ENABLE
    value: "0"
  - name: SL_TFLITE_MICRO_ARENA_SIZE
    value: "100000"
  # Clocking
  - name: SL_CLOCK_MANAGER_HFRCO_DPLL_EN
    value: "1"
  - name: SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE
    value: SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFRCODPLL
  # Audio feature generation
  - name: SL_ML_AUDIO_FEATURE_GENERATION_AUDIO_BUFFER_SIZE
    value: "4096"
  - name: SL_ML_AUDIO_FEATURE_GENERATION_AUDIO_GAIN
    value: "2"
  - condition:
      - tensorflow_lite_micro_accelerated_kernels
    name: SL_MVP_OPTIMIZE_SPEED
    value: "1"
  - name: SL_BOARD_ENABLE_SENSOR_MICROPHONE
    value: "1"
  # SystemView / RTT. Use the sleeptimer as the timestamp tick base so the
  # project compiles out of the box (the DWT cycle-counter source needs an
  # extra device-header include - see readme.md). Trade-off: lower timestamp
  # resolution than DWT.
  - name: SEGGER_SYSVIEW_TIMESTAMP_SOURCE
    value: SEGGER_SYSVIEW_TIMESTAMP_SOURCE_SLEEPTIMER
  - name: SEGGER_RTT_MAX_NUM_UP_BUFFERS
    value: "7"
  - name: SEGGER_RTT_MAX_NUM_DOWN_BUFFERS
    value: "7"

readme:
  - path: readme.md

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
    - path: readme.md
      focus: true
